import java.util.Scanner;

public class cicloWhile {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int idade = 0;
        while (idade < 18) {
            System.out.println("Ingresa tu edad");
            idade = sc.nextInt();
        }
        System.out.println("acceso permitido");
    }
}
