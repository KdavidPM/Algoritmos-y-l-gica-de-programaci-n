public class operadorModulo {
    public static void main(String[] args) {
        int numero1 = 10;
        int numero2 = 3;
        int x = 7;
        int resultado = numero1 % numero2;

        System.out.println("El resultado de " + numero1 + " % " + numero2 + " es: " + resultado);
        if (x %2==0) {
            System.out.println("El número es par.");
